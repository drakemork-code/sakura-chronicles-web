# Required — PostgreSQL connection string (Railway sets this automatically if you add a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required — Secret key for session signing (generate a random string, e.g. openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_random_secret_string

# Set automatically by Railway — do not set manually
# PORT=8080

# Optional — defaults to "production" in Railway deployments
NODE_ENV=production
